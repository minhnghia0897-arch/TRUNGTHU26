# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # CHỈ server-side, không expose ra client

# Mật khẩu vào bảng điều hành. BẮT BUỘC khi đã nối Google Sheet — chưa đặt thì
# API đơn hàng từ chối phục vụ dữ liệu khách (tránh lộ tên/SĐT/địa chỉ).
DASHBOARD_PASSWORD=

# Google Sheet chứa đơn — khách đặt là máy chủ tự ghi vào đây.
# Lấy từ file JSON của service account. Hướng dẫn: docs/google-sheet.md
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=                 # dán nguyên khối, kể cả dòng BEGIN/END
GOOGLE_SHEET_ID=

# Google Drive — nút "Xuất Excel → Lưu vào Google Drive" ở Dashboard.
# Để trống thì vẫn tải file .xlsx về máy được. Hướng dẫn lấy: docs/google-drive.md
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Pancake (Phase 6 — có thể để trống, dùng stub trước)
PANCAKE_SHOP_ID=
PANCAKE_API_KEY=
PANCAKE_WEBHOOK_SECRET=
