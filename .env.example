# =====================================================================
# Supabase — nơi lưu đơn hàng, danh mục sản phẩm và ảnh.
# Khách đặt hàng là máy chủ ghi thẳng vào đây, bảng điều hành đọc ra.
# Hướng dẫn lấy: docs/supabase.md
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # CHỈ server-side, không expose ra client

# Mật khẩu vào bảng điều hành. BẮT BUỘC khi đã nối Supabase — chưa đặt thì
# API đơn hàng từ chối phục vụ dữ liệu khách (tránh lộ tên/SĐT/địa chỉ).
DASHBOARD_PASSWORD=

# Google Drive — nút "Xuất Excel → Lưu vào Google Drive" ở Dashboard.
# Để trống thì vẫn tải file .xlsx về máy được. Hướng dẫn lấy: docs/google-drive.md
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Pancake (Phase 6 — có thể để trống, dùng stub trước)
PANCAKE_SHOP_ID=
PANCAKE_API_KEY=
PANCAKE_WEBHOOK_SECRET=
